{
  "name": "@deepseek-ai/dsh-permaculture-command",
  "description": "Custom /permaculture-help slash command: deterministically calls the n8n Permaculture Ethics & Principles webhook, relays its answer into the agent as a verbatim-relay reply, and — while its thread is open — lets the model continue it via a follow-up tool instead of asking the user to retype the command.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
